# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan pernah meng-commit .env.local (sudah diabaikan oleh .gitignore).

# Harga XAU/USD spot. Daftar gratis di https://twelvedata.com/register
# Tanpa kunci ini, aplikasi mencoba Yahoo Finance (gold futures), lalu data simulasi.
TWELVEDATA_API_KEY=

# Opsional. Angka resmi CPI, NFP, PPI dari BLS.
# Tanpa kunci: 25 permintaan per hari. Dengan kunci gratis: 500 per hari.
# Daftar di https://data.bls.gov/registrationEngine/
BLS_API_KEY=
